# Flask application
FLASK_ENV=development
FLASK_DEBUG=false
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_SECRET_KEY=replace-with-a-new-long-random-secret

# MySQL (local example; use the private RDS endpoint in AWS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=your_database_user
DB_PASSWORD=replace-with-database-password

# Memcached
CACHE_ENABLED=false
MEMCACHED_SERVERS=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_TLS=false
MEMCACHED_POOL_SIZE=8

# RabbitMQ
# Amazon MQ: port 5671 and TLS=true.
# Local RabbitMQ without TLS: usually port 5672 and TLS=false.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=your-private-rabbitmq-hostname
RABBITMQ_PORT=5671
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_TLS=true
RABBITMQ_EMAIL_QUEUE=booking_emails

# Email outbox and retry settings
EMAIL_OUTBOX_POLL_SECONDS=5
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_DELAY_MS=60000

# Amazon SES
# Use the same region as your SES identity and SES VPC interface endpoint.
AWS_REGION=us-east-1
SES_FROM_EMAIL=verified-sender@example.com

LOG_LEVEL=INFO

# Do not add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# On EC2 / Elastic Beanstalk, attach an IAM instance profile with SES permissions.
