
# ==========================================
# FLASK CONFIGURATION
# ==========================================
FLASK_ENV=production
FLASK_DEBUG=False

# ==========================================
# AMAZON RDS - MYSQL
# ==========================================
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=admin
DB_PASSWORD=admin123@

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET_KEY=95-Vo5VBTEXq5perQArO6aQjxDCoLgVhJd0Q6wVO6sTiWnniymp8229T-khshFP0iOaZWNz9noEi6ux76oiuTQ
JWT_ACCESS_TOKEN_EXPIRES=3600

# ==========================================
# AMAZON ELASTICACHE - MEMCACHED
# ==========================================
CACHE_ENABLED=true
MEMCACHED_SERVERS=YOUR_MEMCACHED_NODE_ENDPOINT
MEMCACHED_PORT=11211
MEMCACHED_TLS=true
MEMCACHED_POOL_SIZE=8

# ==========================================
# AMAZON MQ - ACTIVEMQ
# ==========================================
ACTIVEMQ_ENABLED=true
ACTIVEMQ_HOST=YOUR_ACTIVEMQ_BROKER_ENDPOINT
ACTIVEMQ_PORT=61617
ACTIVEMQ_TLS=true
ACTIVEMQ_USER=YOUR_ACTIVEMQ_USERNAME
ACTIVEMQ_PASSWORD=YOUR_ACTIVEMQ_PASSWORD
ACTIVEMQ_EMAIL_QUEUE=booking_emails

# ==========================================
# EMAIL - AMAZON SES
# ==========================================
EMAIL_ENABLED=true
EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1
SES_FROM_EMAIL=YOUR_VERIFIED_EMAIL_ADDRESS

# ==========================================
# EMAIL OUTBOX
# ==========================================
EMAIL_OUTBOX_POLL_SECONDS=5

# ==========================================
# APPOINTMENT PAYMENT
# ==========================================
# Simulated payment; no payment gateway is configured.
